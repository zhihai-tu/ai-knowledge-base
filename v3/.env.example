# LLM 提供商: deepseek | qwen | openai | glm
LLM_PROVIDER=deepseek

# DeepSeek API Key (https://platform.deepseek.com)
DEEPSEEK_API_KEY=

# 阿里云百炼 (Qwen) API Key
DASHSCOPE_API_KEY=

# 可选：百炼专属网关 OpenAI 兼容地址（不填则用默认公共版 https://dashscope-intl.aliyuncs.com/compatible-mode/v1）
QWEN_BASE_URL=

# 可选：百炼模型名覆盖（不填则默认 qwen-plus）
QWEN_MODEL=

# 智谱 GLM API Key（https://open.bigmodel.cn）
GLM_API_KEY=

# 可选：GLM base_url 覆盖（不填则默认官方 https://open.bigmodel.cn/api/paas/v4）
# 使用商汤 SenseNova 第三方接入时填 https://token.sensenova.cn/v1（API Key 用 SenseNova 控制台创建的 sk- key）
GLM_BASE_URL=

# 可选：GLM 模型名覆盖（不填则默认 glm-5.2）
GLM_MODEL=

# 日志级别: DEBUG | INFO | WARNING | ERROR（默认 INFO，--verbose 时强制 DEBUG）
LOG_LEVEL=INFO

# OpenAI API Key
OPENAI_API_KEY=
